{
  "name": "command-os",
  "version": "1.0.0",
  "private": true,
  "description": "COMMAND \u2014 a private, data-driven personal operating system.",
  "scripts": {
    "predev": "node scripts/gen-schema.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/gen-schema.mjs",
    "build": "next build",
    "start": "next start",
    "gen:schema": "node scripts/gen-schema.mjs",
    "seed": "node scripts/gen-schema.mjs && tsx --conditions=react-server scripts/seed.mts",
    "reset": "node scripts/gen-schema.mjs && tsx --conditions=react-server scripts/seed.mts --reset",
    "typecheck": "node scripts/gen-schema.mjs && tsc --noEmit",
    "test": "node scripts/gen-schema.mjs && tsx --conditions=react-server --test \"tests/*.test.ts\" \"tests/*.test.mts\"",
    "demo": "node scripts/gen-schema.mjs && tsx --conditions=react-server scripts/seed.mts --reset --demo",
    "postbuild": "node scripts/seed-if-remote.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
